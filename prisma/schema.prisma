generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String         @id @default(uuid())
  username           String         @unique
  email              String         @unique
  passwordHash       String
  // False only for accounts whose passwordHash is a random, unknowable
  // placeholder (Google-created/claimed accounts that never set a real
  // password). Existing rows default to true — the safe assumption, since
  // treating a real password as "none" would let a change-password request
  // skip verification entirely. Google flows explicitly set this false.
  hasPassword        Boolean        @default(true)
  // Bumped on password change/reset so every previously-issued JWT
  // (which embeds the version at sign time) is invalidated at once —
  // otherwise a stolen token stays valid for its full 30-day life even
  // after the owner changes their password. Missing/undefined on an
  // older token is treated as 0, so this doesn't log out existing
  // sessions the moment it ships.
  tokenVersion       Int            @default(0)
  // Optional, collected at signup or later from the profile. Sent to Nector
  // as metadetail.mobile on lead creation so a person's forum-earned points
  // can be consolidated with their real Shopify/checkout account, which
  // Nector links by phone number rather than email (confirmed with Nector
  // support — the leads API creates a Nector-only record with no automatic
  // Shopify-account link, but shared-phone-number consolidation is available
  // as a workspace feature).
  phone              String?
  city               String
  childAge           String?
  // Second+ kids. childAge above stays the "primary" one — it's what thread
  // authorship tags a post with, what signup collects, and what old rows
  // already have. This is purely additive, for parents with more than one
  // child, so "For Your Age" personalization can match any of their kids.
  childAges          String[]       @default([])
  role               UserRole       @default(MEMBER)
  badges             Json?
  createdAt          DateTime       @default(now())
  isVerified         Boolean        @default(false)
  postCount          Int            @default(0)
  replyCount         Int            @default(0)
  totalUpvotes       Int            @default(0)
  trustScore         Int            @default(0)
  emailNotifications Boolean        @default(true)
  // Set from a Resend webhook (email.bounced / email.complained) when a
  // send to this address hard-fails — "Recipient not found" etc. Once set,
  // sendEmail() skips this address entirely: retrying a dead/mistyped
  // address on every signup bonus, reply notification, and weekly digest
  // does nothing but pile up bounces against our sender reputation, which
  // can get transactional mail (password resets) throttled or spam-foldered
  // for EVERY user, not just this one.
  emailBounced       Boolean        @default(false)
  emailBounceReason  String?
  savedPosts         Int[]
  // Categories the user picked during the welcome flow. Powers a "For you"
  // sort weighting and could seed personalised digests later. Empty = show
  // everything without personalisation.
  interests          String[]       @default([])
  chatSessions       ChatSession[]
  conversations      Conversation[]
  notifications      Notification[]
  replies            Reply[]
  votes              Vote[]
  follows            Follow[]       @relation("Follower")
  followers          Follow[]       @relation("FollowedUser")
  loginEvents        LoginEvent[]
  blockedUsers       Block[]        @relation("Blocker")
  blockedByUsers     Block[]        @relation("Blocked")
}

// A one-way "I don't want to see this person's content" relationship —
// blocking isn't mutual, only hides the blocked user's threads/replies from
// the blocker's own feed (nothing is deleted, and the blocked user isn't
// told). Same NULL-treated-as-distinct trick as Vote/Follow's unique
// constraints to keep one row per (blocker, blocked) pair.
model Block {
  id        String   @id @default(uuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
}

model Conversation {
  id               Int              @id @default(autoincrement())
  title            String
  category         String
  isPinned         Boolean          @default(false)
  isHot            Boolean          @default(false)
  isFeatured       Boolean          @default(false)
  featuredLabel    String?
  // "Highlights of the week" — a single thread manually/cron-rotated into
  // this slot, distinct from isFeatured (used elsewhere for "Circle Mom of
  // the Month"). Only one row should be true at a time; enforced by the
  // rotation code, not the DB.
  isWeeklyHighlight Boolean         @default(false)
  votes            Int              @default(0)
  views            Int              @default(0)
  opAuthor         String
  opCity           String
  opTime           String
  opText           String
  opImage          String?
  // Multi-image support. opImage stays for backwards compat and is always
  // the first entry in opImages when present. New posts write both.
  opImages         String[]         @default([])
  opAuthorRole     UserRole         @default(MEMBER)
  opAuthorBadges   String[]
  // Age-of-child bucket this thread is about. Set on create from the author's
  // current User.childAge (so a thread stays tagged even if the parent's kid
  // ages later). Nullable to keep old rows valid until backfill runs.
  childAge         String?
  moderationStatus ModerationStatus @default(PENDING)
  moderatedBy      String?
  moderationReason String?
  createdAt        DateTime         @default(now())
  authorId         String
  greyAreaFlags    String[]
  reviewPriority   Int?
  // The reply the original poster marked as "this worked" — no formal
  // relation object (Reply already has a differently-named relation back to
  // Conversation via conversationId), just a plain id looked up manually
  // where needed. Only the thread author (or a mod) may set this, and only
  // to a reply that belongs to this same conversation.
  resolvedReplyId  Int?
  // Restrict (not Cascade): deleting a user with conversations is blocked at the DB level.
  // This prevents accidental wipes (e.g. if the seed user is deleted via raw SQL).
  // To delete a user with content, their content must be reassigned or deleted first.
  author           User             @relation(fields: [authorId], references: [id], onDelete: Restrict)
  replies          Reply[]
  votesRelation    Vote[]           @relation("VoteToConversation")
  followers        Follow[]         @relation("FollowedConversation")

  // Hot-path indexes: moderation queue filters by status, "my posts"
  // filters by author, and the age filter groups by childAge.
  @@index([authorId])
  @@index([moderationStatus])
  @@index([childAge])
}

model Reply {
  id               Int              @id @default(autoincrement())
  conversationId   Int
  author           String
  authorId         String
  city             String
  time             String
  text             String
  image            String?
  images           String[]         @default([])
  likes            Int              @default(0)
  authorRole       UserRole         @default(MEMBER)
  authorBadges     String[]
  moderationStatus ModerationStatus @default(PENDING)
  parentId         Int?
  createdAt        DateTime         @default(now())
  // Same protection as Conversation.author — blocks accidental user-deletion cascades.
  authorUser       User             @relation(fields: [authorId], references: [id], onDelete: Restrict)
  conversation     Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  parent           Reply?           @relation("ReplyToReply", fields: [parentId], references: [id], onDelete: Cascade)
  replies          Reply[]          @relation("ReplyToReply")
  votesRelation    Vote[]           @relation("VoteToReply")

  // Hot-paths: every thread render fetches replies by conversationId,
  // "my replies" filters by authorId, mod queue filters by status.
  @@index([conversationId])
  @@index([authorId])
  @@index([moderationStatus])
}

model Vote {
  id             String        @id @default(uuid())
  userId         String
  conversationId Int?
  replyId        Int?
  type           VoteType
  createdAt      DateTime      @default(now())
  conversation   Conversation? @relation("VoteToConversation", fields: [conversationId], references: [id], onDelete: Cascade)
  reply          Reply?        @relation("VoteToReply", fields: [replyId], references: [id], onDelete: Cascade)
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  // One vote per user per target. Postgres treats NULLs as distinct, so the
  // conversation constraint only binds conversation-votes and the reply
  // constraint only binds reply-votes — exactly what we want.
  @@unique([userId, conversationId])
  @@unique([userId, replyId])
  // Hot-path: aggregating vote counts by target for feed rendering.
  @@index([conversationId])
  @@index([replyId])
}

model Notification {
  id          Int              @id @default(autoincrement())
  userId      String
  type        NotificationType
  title       String
  description String
  time        String
  read        Boolean          @default(false)
  threadId    Int?
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Hot-path index: every logged-in user hits /api/notifications on load,
  // filtered by userId. Also indexed on threadId so post-rejection cleanup
  // can wipe notifications for a specific thread cheaply.
  @@index([userId])
  @@index([threadId])
}

model ChatSession {
  id         String        @id @default(uuid())
  userId     String
  createdAt  DateTime      @default(now())
  lastActive DateTime      @default(now())
  messages   ChatMessage[]
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ChatMessage {
  id        String      @id @default(uuid())
  sessionId String
  role      ChatRole
  content   String
  timestamp DateTime    @default(now())
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model ModerationLog {
  id          String           @id @default(uuid())
  moderatorId String
  targetType  ModerationTarget
  targetId    Int
  action      ModerationAction
  reason      String?
  timestamp   DateTime         @default(now())
}

model Category {
  id        String @id
  label     String
  icon      String
  className String
  count     Int    @default(0)
  bg        String
  text      String
  border    String
}

model Product {
  id       String @id
  name     String
  icon     String
  subtitle String
  tag      String
  price    String
  linkUrl  String
}

model EmailLog {
  id      String    @id @default(uuid())
  type    EmailType
  to      String
  subject String
  sentAt  DateTime  @default(now())
  preview String
}

enum UserRole {
  GUEST
  MEMBER
  TRUSTED
  MODERATOR
  TUCO_TEAM
}

enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
  FLAGGED
}

enum VoteType {
  UP
  DOWN
}

enum NotificationType {
  REPLY
  LIKE
  BADGE
  SYSTEM
}

enum ChatRole {
  USER
  ASSISTANT
}

enum ModerationTarget {
  CONVERSATION
  REPLY
}

enum ModerationAction {
  APPROVED
  REJECTED
  FLAGGED
  // A conversation/reply delete never used to write anything here at all —
  // it just vanished with zero trace of who deleted it, when, or why. Any
  // report against that content stayed permanently "open" in the
  // moderation queue with no way to close it and no answer to "why was
  // this deleted" beyond "it's gone." DELETE routes now log this.
  DELETED
  // Closes an open report against content that's already gone by the time
  // a moderator looks at it (deleted through some other path — the
  // author's own account deletion, a direct DB cleanup, etc.) — lets the
  // queue actually clear instead of retrying a PATCH against a conversation
  // id that no longer exists.
  DISMISSED
}

enum EmailType {
  APPROVAL
  WEEKLY_ENGAGEMENT
  LAUNCH
  WELCOME
  REPLY_NOTIFICATION
  MODERATION
  TRANSACTIONAL
}

enum LoginMethod {
  EMAIL
  GOOGLE
}

// One row per successful sign-in, for basic login-activity visibility
// (who logged in, when, from where) — separate from User.createdAt, which
// only captures the original signup.
model LoginEvent {
  id        Int         @id @default(autoincrement())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  method    LoginMethod
  ipAddress String?
  userAgent String?
  createdAt DateTime    @default(now())

  @@index([userId])
  @@index([createdAt])
}

// User→user and user→thread follow relationships. One row per follow, with
// exactly one of targetUserId / targetConversationId set. Cascading delete so
// removing a user or thread automatically cleans up its follows.
model Follow {
  id                   String        @id @default(uuid())
  followerId           String
  targetUserId         String?
  targetConversationId Int?
  createdAt            DateTime      @default(now())

  follower             User          @relation("Follower",       fields: [followerId],           references: [id], onDelete: Cascade)
  targetUser           User?         @relation("FollowedUser",   fields: [targetUserId],         references: [id], onDelete: Cascade)
  targetConversation   Conversation? @relation("FollowedConversation", fields: [targetConversationId], references: [id], onDelete: Cascade)

  // Postgres treats NULLs as distinct — so a (follower, user) pair binds only
  // user-follows and (follower, conversation) binds only thread-follows.
  @@unique([followerId, targetUserId])
  @@unique([followerId, targetConversationId])
  @@index([targetUserId])
  @@index([targetConversationId])
}

// Ledger of every Nector points award actually made, keyed so the same
// source (a signup email, a specific post, a specific reply) can only ever
// award once — this is what makes the award idempotent against a
// double-click/replayed request race (the same protection votes already
// get from their own DB unique constraint), and lets delete handlers check
// "was this ever awarded" before deciding whether a reversal is owed.
// sourceId is a string so one column covers a normalized email (signup),
// a conversation id, or a reply id.
model NectorAward {
  id         String   @id @default(uuid())
  userId     String
  sourceType String   // 'SIGNUP' | 'POST' | 'REPLY'
  sourceId   String
  triggerId  String
  createdAt  DateTime @default(now())

  @@unique([sourceType, sourceId])
  @@index([userId])
}

// Password-reset tokens, persisted so they survive server restarts and work
// across instances (previously an in-memory Map, lost on every deploy).
model PasswordResetToken {
  token     String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// One-time OAuth exchange codes, persisted for the same reason.
model OAuthCode {
  code      String   @id
  token     String
  isNew     Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
}
